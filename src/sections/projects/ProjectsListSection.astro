---
import type { Locale, Project } from '@/data/portfolio';

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  projectsByLocale: Record<Locale, Project[]>;
  titleByLocale: Record<Locale, string>;
  backLabelByLocale: Record<Locale, string>;
  visitProjectLabelByLocale: Record<Locale, string>;
}

const { projectsByLocale, titleByLocale, backLabelByLocale, visitProjectLabelByLocale } = Astro.props;
const backHref = '/';
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projects/*.{jpeg,jpg,png,gif}');
---

<section class="container-editorial py-24 sm:py-32">
  <div class="mb-14 space-y-6">
    <a
      href={backHref}
      class="group inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground transition-colors hover:text-foreground"
    >
      <span class="transition-transform group-hover:-translate-x-1" aria-hidden="true">←</span>
      <span data-i18n-locale="es">{backLabelByLocale.es}</span>
      <span data-i18n-locale="en">{backLabelByLocale.en}</span>
    </a>
    <h1 class="section-title">
      <span data-i18n-locale="es">{titleByLocale.es}</span>
      <span data-i18n-locale="en">{titleByLocale.en}</span>
    </h1>
  </div>

  <div data-i18n-locale="es" class="grid grid-cols-1 gap-x-6 gap-y-14 md:grid-cols-2">
    {
      projectsByLocale.es.map((project) => {
        const hasExternalLink = Boolean(project.link && project.link !== '#');
        return (
          <a
            href={hasExternalLink ? project.link : '#'}
            target={hasExternalLink ? '_blank' : undefined}
            rel={hasExternalLink ? 'noopener noreferrer' : undefined}
            class="group flex flex-col gap-[18px]"
          >
            <div class="relative aspect-[4/3] overflow-hidden rounded-[2px] border" style="border-color: hsl(var(--line)); background: hsl(var(--bg-soft));">
              {project.image && (
                <div class="absolute inset-0 transition-transform duration-700 ease-out group-hover:scale-[1.03]">
                  <Image
                    src={images[project.image!]()}
                    alt={project.title}
                    class="h-full w-full object-cover"
                  />
                </div>
              )}
              <span class="absolute top-3.5 left-3.5 z-10 font-mono text-[10.5px] tracking-[0.1em] text-muted-foreground">
                {project.id} / {project.year}
              </span>
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-background/70 via-transparent to-transparent" />
            </div>
            <div class="flex items-center justify-between font-mono text-[10.5px] uppercase tracking-[0.1em] text-muted-foreground">
              <span>{project.client}</span>
              <span>{project.year}</span>
            </div>
            <h2 class="font-serif text-[22px] sm:text-[24px] font-normal tracking-[-0.01em] leading-[1.2]">
              {project.title}
            </h2>
            <p class="text-[14.5px] leading-[1.5] text-muted-foreground">{project.description}</p>
            <div class="flex flex-wrap gap-x-3">
              {project.tags.map((tag, idx) => (
                <span class="font-mono text-[10.5px] text-muted-foreground">
                  {tag}
                  {idx < project.tags.length - 1 && <span class="ml-1.5" style="color: hsl(var(--text-dim));">·</span>}
                </span>
              ))}
            </div>
            {hasExternalLink && (
              <span class="mt-1 inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground transition-colors group-hover:text-foreground">
                {visitProjectLabelByLocale.es}
                <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>
            )}
          </a>
        );
      })
    }
  </div>

  <div data-i18n-locale="en" class="grid grid-cols-1 gap-x-6 gap-y-14 md:grid-cols-2">
    {
      projectsByLocale.en.map((project) => {
        const hasExternalLink = Boolean(project.link && project.link !== '#');
        return (
          <a
            href={hasExternalLink ? project.link : '#'}
            target={hasExternalLink ? '_blank' : undefined}
            rel={hasExternalLink ? 'noopener noreferrer' : undefined}
            class="group flex flex-col gap-[18px]"
          >
            <div class="relative aspect-[4/3] overflow-hidden rounded-[2px] border" style="border-color: hsl(var(--line)); background: hsl(var(--bg-soft));">
              {project.image && (
                <div class="absolute inset-0 transition-transform duration-700 ease-out group-hover:scale-[1.03]">
                  <Image
                    src={images[project.image!]()}
                    alt={project.title}
                    class="h-full w-full object-cover"
                  />
                </div>
              )}
              <span class="absolute top-3.5 left-3.5 z-10 font-mono text-[10.5px] tracking-[0.1em] text-muted-foreground">
                {project.id} / {project.year}
              </span>
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-background/70 via-transparent to-transparent" />
            </div>
            <div class="flex items-center justify-between font-mono text-[10.5px] uppercase tracking-[0.1em] text-muted-foreground">
              <span>{project.client}</span>
              <span>{project.year}</span>
            </div>
            <h2 class="font-serif text-[22px] sm:text-[24px] font-normal tracking-[-0.01em] leading-[1.2]">
              {project.title}
            </h2>
            <p class="text-[14.5px] leading-[1.5] text-muted-foreground">{project.description}</p>
            <div class="flex flex-wrap gap-x-3">
              {project.tags.map((tag, idx) => (
                <span class="font-mono text-[10.5px] text-muted-foreground">
                  {tag}
                  {idx < project.tags.length - 1 && <span class="ml-1.5" style="color: hsl(var(--text-dim));">·</span>}
                </span>
              ))}
            </div>
            {hasExternalLink && (
              <span class="mt-1 inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground transition-colors group-hover:text-foreground">
                {visitProjectLabelByLocale.en}
                <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>
            )}
          </a>
        );
      })
    }
  </div>
</section>
