---
import type { Experience, Locale } from '@/data/portfolio';

interface Props {
  experiencesByLocale: Record<Locale, Experience[]>;
  kickerByLocale: Record<Locale, string>;
  headlineByLocale: Record<Locale, string>;
  viewFullLabelByLocale: Record<Locale, string>;
  fullExperienceHref: string;
}

const { experiencesByLocale, kickerByLocale, headlineByLocale, viewFullLabelByLocale, fullExperienceHref } =
  Astro.props;

const localeKeys: Locale[] = ['es', 'en'];

const labelByLocale = {
  es: { roles: 'roles' },
  en: { roles: 'roles' },
};
---

<div id="experience" class="space-y-6">
  <span class="eyebrow">
    <span data-i18n-locale="es">{kickerByLocale.es}</span>
    <span data-i18n-locale="en">{kickerByLocale.en}</span>
  </span>
  <h2 class="section-title">
    <span data-i18n-locale="es">{headlineByLocale.es}</span>
    <span data-i18n-locale="en">{headlineByLocale.en}</span>
  </h2>

  {
    localeKeys.map((locale) => {
      const labels = labelByLocale[locale];
      return (
        <ol data-i18n-locale={locale} class="exp-rail pt-6">
          {experiencesByLocale[locale].map((exp) => {
            const isMulti = exp.roles.length > 1;
            const allTags = Array.from(new Set(exp.roles.flatMap((r) => r.tags)));
            return (
              <li class={`exp-company${exp.current ? ' is-current' : ''}${isMulti ? ' is-multi' : ''}`}>
                <div class="exp-summary-card">
                  <span class="exp-period">
                    {exp.period}
                    {exp.duration && <span class="exp-duration"> · {exp.duration}</span>}
                    {isMulti && <span class="exp-duration"> · {exp.roles.length} {labels.roles}</span>}
                  </span>
                  {isMulti ? (
                    <h3 class="exp-company-name">{exp.company}</h3>
                  ) : (
                    <h3 class="exp-role">
                      {exp.roles[0].role}
                      <span class="exp-company-inline"> · {exp.company}</span>
                    </h3>
                  )}
                  {exp.location && <span class="exp-location">{exp.location}</span>}
                  {allTags.length > 0 && (
                    <div class="exp-tags">
                      {allTags.map((t) => (
                        <span class="exp-tag">{t}</span>
                      ))}
                    </div>
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      );
    })
  }

  <div class="pt-6">
    <a href={fullExperienceHref} class="btn">
      <span data-i18n-locale="es">{viewFullLabelByLocale.es}</span>
      <span data-i18n-locale="en">{viewFullLabelByLocale.en}</span>
      <span class="arrow" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </span>
    </a>
  </div>
</div>

<style>
  .exp-rail {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  .exp-company {
    list-style: none;
    position: relative;
    padding: 0 0 0 28px;
    border-top: 1px solid hsl(var(--line));
  }

  .exp-company:last-child {
    border-bottom: 1px solid hsl(var(--line));
  }

  .exp-company::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: hsl(var(--line));
  }

  .exp-company::after {
    content: '';
    position: absolute;
    left: 0;
    top: 32px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: hsl(var(--background));
    border: 1px solid hsl(var(--muted-foreground));
    transition:
      background 0.3s ease,
      border-color 0.3s ease;
  }

  .exp-company:hover::after {
    border-color: hsl(var(--brand));
    background: hsl(var(--brand-soft));
  }

  .exp-company.is-current::after {
    background: #2ee598;
    border-color: #2ee598;
    box-shadow: 0 0 0 4px rgba(46, 229, 152, 0.18);
  }

  .exp-summary-card {
    padding: 24px 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .exp-period {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: hsl(var(--muted-foreground));
    text-transform: uppercase;
  }

  .exp-duration {
    color: hsl(var(--text-dim));
  }

  .exp-role,
  .exp-company-name {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 0;
  }

  .exp-company-inline {
    color: hsl(var(--muted-foreground));
    font-style: italic;
  }

  .exp-location {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: hsl(var(--text-dim));
  }

  .exp-tags {
    margin-top: 6px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .exp-tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    padding: 3px 8px;
    background: hsl(var(--bg-soft));
    border: 1px solid hsl(var(--line));
    border-radius: 4px;
    color: hsl(var(--muted-foreground));
    letter-spacing: 0.02em;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .exp-company:hover .exp-tag {
    border-color: hsl(var(--line-strong));
  }

  @media (max-width: 600px) {
    .exp-company {
      padding-left: 22px;
    }
    .exp-role,
    .exp-company-name {
      font-size: 19px;
    }
  }
</style>
