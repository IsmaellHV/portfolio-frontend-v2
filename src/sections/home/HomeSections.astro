---
import type { Locale, LocaleMessages, PortfolioData } from '@/data/portfolio';
import { routesForLocale } from '@/consts/routes';
import HeroSection from './HeroSection.astro';
import AboutSection from './AboutSection.astro';
import ExperienceSection from './ExperienceSection.astro';
import ProjectsSection from './ProjectsSection.astro';
import ContactSection from './ContactSection.astro';

const routes = routesForLocale();

interface Props {
  dataByLocale: Record<Locale, PortfolioData>;
  messagesByLocale: Record<Locale, LocaleMessages>;
}

const { dataByLocale, messagesByLocale } = Astro.props;
---

<div>
  <HeroSection
    profileByLocale={{ es: dataByLocale.es.profile, en: dataByLocale.en.profile }}
    statsByLocale={{ es: dataByLocale.es.stats, en: dataByLocale.en.stats }}
    workLabelByLocale={{
      es: messagesByLocale.es.actions.workTogether,
      en: messagesByLocale.en.actions.workTogether,
    }}
    seeProjectsLabelByLocale={{
      es: messagesByLocale.es.actions.seeProjects,
      en: messagesByLocale.en.actions.seeProjects,
    }}
  />

  <section class="border-t py-24 sm:py-32" style="border-color: hsl(var(--line));">
    <div class="container-editorial">
      <div class="grid gap-16 lg:grid-cols-2 lg:gap-20">
        <AboutSection
          aboutByLocale={{ es: dataByLocale.es.about, en: dataByLocale.en.about }}
          kickerByLocale={{
            es: dataByLocale.es.sections.about,
            en: dataByLocale.en.sections.about,
          }}
          headlineByLocale={{
            es: dataByLocale.es.sections.aboutHeadline,
            en: dataByLocale.en.sections.aboutHeadline,
          }}
        />
        <ExperienceSection
          experiencesByLocale={{
            es: dataByLocale.es.experiences,
            en: dataByLocale.en.experiences,
          }}
          kickerByLocale={{
            es: dataByLocale.es.sections.experience,
            en: dataByLocale.en.sections.experience,
          }}
          headlineByLocale={{
            es: dataByLocale.es.sections.experienceHeadline,
            en: dataByLocale.en.sections.experienceHeadline,
          }}
          viewFullLabelByLocale={{
            es: messagesByLocale.es.actions.viewFullExperience,
            en: messagesByLocale.en.actions.viewFullExperience,
          }}
          fullExperienceHref={routes.experienceFull}
        />
      </div>
    </div>
  </section>

  <div class="border-t" style="border-color: hsl(var(--line));">
    <ProjectsSection
      projectsByLocale={{
        es: dataByLocale.es.featuredProjects,
        en: dataByLocale.en.featuredProjects,
      }}
      kickerByLocale={{
        es: dataByLocale.es.sections.projects,
        en: dataByLocale.en.sections.projects,
      }}
      headlineByLocale={{
        es: dataByLocale.es.sections.projectsHeadline,
        en: dataByLocale.en.sections.projectsHeadline,
      }}
      viewAllLabelByLocale={{
        es: messagesByLocale.es.actions.viewAllProjects,
        en: messagesByLocale.en.actions.viewAllProjects,
      }}
    />
  </div>

  <ContactSection
    messagesByLocale={{
      es: messagesByLocale.es.contact,
      en: messagesByLocale.en.contact,
    }}
  />
</div>
