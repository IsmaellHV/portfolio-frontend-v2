---
import type { Locale, Project } from '@/data/portfolio';

interface Props {
  projectsByLocale: Record<Locale, Project[]>;
  titleByLocale: Record<Locale, string>;
  viewAllLabelByLocale: Record<Locale, string>;
}

const { projectsByLocale, titleByLocale, viewAllLabelByLocale } = Astro.props;
const projectsHref = '/projects';
---

<section id="projects" class="space-y-8">
  <h2 class="text-sm font-medium tracking-wider uppercase text-foreground/50">
    <span data-i18n-locale="es">{titleByLocale.es}</span>
    <span data-i18n-locale="en">{titleByLocale.en}</span>
  </h2>

  <div data-i18n-locale="es" class="space-y-1">
    {projectsByLocale.es.map((project, index) => {
      const hasExternalLink = Boolean(project.link && project.link !== '#');

      return hasExternalLink ? (
        <a href={project.link} target="_blank" rel="noopener noreferrer" class="group -mx-4 block rounded-md px-4 py-6 transition-all duration-300 hover:bg-muted/30">
          <div class="space-y-3">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1">
                <div class="mb-2 flex items-baseline gap-3">
                  <h3 class="text-base font-semibold text-foreground transition-colors group-hover:text-primary md:text-lg">{project.title}</h3>
                </div>
                <p class="mb-3 text-sm leading-relaxed text-muted-foreground">{project.description}</p>
                <div class="flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <span class="relative overflow-hidden rounded-full border border-border/40 bg-secondary/50 px-2.5 py-1 font-mono text-xs text-foreground/70 transition-colors group-hover:border-border/60">{tag}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
          {index < projectsByLocale.es.length - 1 && <div class="mt-6 border-b border-border/30 transition-colors group-hover:border-border/50" />}
        </a>
      ) : (
        <article class="group -mx-4 block rounded-md px-4 py-6 transition-all duration-300 hover:bg-muted/30">
          <div class="space-y-3">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1">
                <div class="mb-2 flex items-baseline gap-3">
                  <h3 class="text-base font-semibold text-foreground transition-colors group-hover:text-primary md:text-lg">{project.title}</h3>
                </div>
                <p class="mb-3 text-sm leading-relaxed text-muted-foreground">{project.description}</p>
                <div class="flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <span class="relative overflow-hidden rounded-full border border-border/40 bg-secondary/50 px-2.5 py-1 font-mono text-xs text-foreground/70 transition-colors group-hover:border-border/60">{tag}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
          {index < projectsByLocale.es.length - 1 && <div class="mt-6 border-b border-border/30 transition-colors group-hover:border-border/50" />}
        </article>
      );
    })}
  </div>

  <div data-i18n-locale="en" class="space-y-1">
    {projectsByLocale.en.map((project, index) => {
      const hasExternalLink = Boolean(project.link && project.link !== '#');

      return hasExternalLink ? (
        <a href={project.link} target="_blank" rel="noopener noreferrer" class="group -mx-4 block rounded-md px-4 py-6 transition-all duration-300 hover:bg-muted/30">
          <div class="space-y-3">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1">
                <div class="mb-2 flex items-baseline gap-3">
                  <h3 class="text-base font-semibold text-foreground transition-colors group-hover:text-primary md:text-lg">{project.title}</h3>
                </div>
                <p class="mb-3 text-sm leading-relaxed text-muted-foreground">{project.description}</p>
                <div class="flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <span class="relative overflow-hidden rounded-full border border-border/40 bg-secondary/50 px-2.5 py-1 font-mono text-xs text-foreground/70 transition-colors group-hover:border-border/60">{tag}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
          {index < projectsByLocale.en.length - 1 && <div class="mt-6 border-b border-border/30 transition-colors group-hover:border-border/50" />}
        </a>
      ) : (
        <article class="group -mx-4 block rounded-md px-4 py-6 transition-all duration-300 hover:bg-muted/30">
          <div class="space-y-3">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1">
                <div class="mb-2 flex items-baseline gap-3">
                  <h3 class="text-base font-semibold text-foreground transition-colors group-hover:text-primary md:text-lg">{project.title}</h3>
                </div>
                <p class="mb-3 text-sm leading-relaxed text-muted-foreground">{project.description}</p>
                <div class="flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <span class="relative overflow-hidden rounded-full border border-border/40 bg-secondary/50 px-2.5 py-1 font-mono text-xs text-foreground/70 transition-colors group-hover:border-border/60">{tag}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
          {index < projectsByLocale.en.length - 1 && <div class="mt-6 border-b border-border/30 transition-colors group-hover:border-border/50" />}
        </article>
      );
    })}
  </div>

  <div class="pt-6">
    <a href={projectsHref} class="group inline-flex items-center gap-2 text-sm font-medium text-foreground/70 transition-colors hover:text-foreground">
      <span data-i18n-locale="es">{viewAllLabelByLocale.es}</span>
      <span data-i18n-locale="en">{viewAllLabelByLocale.en}</span>
      <span class="transition-transform group-hover:translate-x-1">→</span>
    </a>
  </div>
</section>
