---
import type { Locale, Project } from '@/data/portfolio';

interface Props {
  projectsByLocale: Record<Locale, Project[]>;
  titleByLocale: Record<Locale, string>;
  viewAllLabelByLocale: Record<Locale, string>;
}

const { projectsByLocale, titleByLocale, viewAllLabelByLocale } = Astro.props;
const projectsHref = '/projects';
---

<section id="projects" class="space-y-8">
  <h2 class="text-sm font-medium tracking-wider uppercase text-foreground/50">
    <span data-i18n-locale="es">{titleByLocale.es}</span>
    <span data-i18n-locale="en">{titleByLocale.en}</span>
  </h2>

  <div data-i18n-locale="es" class="space-y-1">
    {
      projectsByLocale.es.map((project, index) => {
        const hasExternalLink = Boolean(project.link && project.link !== '#');

        return (
          <article class="group -mx-4 block rounded-md px-4 py-6 transition-all duration-300 hover:bg-muted/30">
            <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 items-start">
              {project.image && (
                <div class="w-full sm:w-1/3 shrink-0 overflow-hidden rounded border border-border/50 bg-foreground/10 dark:bg-black/50">
                  <a
                    href={hasExternalLink ? project.link : '#'}
                    target={hasExternalLink ? '_blank' : undefined}
                    rel={hasExternalLink ? 'noopener noreferrer' : undefined}
                    class="block h-full"
                  >
                    <img
                      src={project.image}
                      alt={project.title}
                      class="w-full aspect-video object-cover grayscale opacity-60 transition-all duration-500 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105"
                    />
                  </a>
                </div>
              )}
              <div class="flex-1 space-y-3">
                <div class="flex items-start justify-between gap-4">
                  <div class="flex-1">
                    <div class="mb-2 flex flex-wrap items-center gap-3">
                      <h3 class="text-base font-semibold text-foreground md:text-lg">
                        <a
                          href={hasExternalLink ? project.link : '#'}
                          target={hasExternalLink ? '_blank' : undefined}
                          rel={hasExternalLink ? 'noopener noreferrer' : undefined}
                          class="transition-colors hover:text-primary"
                        >
                          {project.title}
                        </a>
                      </h3>
                      {project.github && (
                        <a
                          href={project.github}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-xs font-mono text-muted-foreground transition-colors hover:text-foreground"
                        >
                          [GitHub]
                        </a>
                      )}
                    </div>
                    <p class="mb-3 text-sm leading-relaxed text-muted-foreground">{project.description}</p>
                    <div class="flex flex-wrap gap-2">
                      {project.tags.map((tag) => (
                        <span class="relative overflow-hidden rounded-full border border-border/40 bg-secondary/50 px-2.5 py-1 font-mono text-xs text-foreground/70 transition-colors group-hover:border-border/60">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>
            {index < projectsByLocale.es.length - 1 && (
              <div class="mt-6 border-b border-border/30 transition-colors group-hover:border-border/50" />
            )}
          </article>
        );
      })
    }
  </div>

  <div data-i18n-locale="en" class="space-y-1">
    {
      projectsByLocale.en.map((project, index) => {
        const hasExternalLink = Boolean(project.link && project.link !== '#');

        return (
          <article class="group -mx-4 block rounded-md px-4 py-6 transition-all duration-300 hover:bg-muted/30">
            <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 items-start">
              {project.image && (
                <div class="w-full sm:w-1/3 shrink-0 overflow-hidden rounded border border-border/50 bg-foreground/10 dark:bg-black/50">
                  <a
                    href={hasExternalLink ? project.link : '#'}
                    target={hasExternalLink ? '_blank' : undefined}
                    rel={hasExternalLink ? 'noopener noreferrer' : undefined}
                    class="block h-full"
                  >
                    <img
                      src={project.image}
                      alt={project.title}
                      class="w-full aspect-video object-cover grayscale opacity-60 transition-all duration-500 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105"
                    />
                  </a>
                </div>
              )}
              <div class="flex-1 space-y-3">
                <div class="flex items-start justify-between gap-4">
                  <div class="flex-1">
                    <div class="mb-2 flex flex-wrap items-center gap-3">
                      <h3 class="text-base font-semibold text-foreground md:text-lg">
                        <a
                          href={hasExternalLink ? project.link : '#'}
                          target={hasExternalLink ? '_blank' : undefined}
                          rel={hasExternalLink ? 'noopener noreferrer' : undefined}
                          class="transition-colors hover:text-primary"
                        >
                          {project.title}
                        </a>
                      </h3>
                      {project.github && (
                        <a
                          href={project.github}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-xs font-mono text-muted-foreground transition-colors hover:text-foreground"
                        >
                          [GitHub]
                        </a>
                      )}
                    </div>
                    <p class="mb-3 text-sm leading-relaxed text-muted-foreground">{project.description}</p>
                    <div class="flex flex-wrap gap-2">
                      {project.tags.map((tag) => (
                        <span class="relative overflow-hidden rounded-full border border-border/40 bg-secondary/50 px-2.5 py-1 font-mono text-xs text-foreground/70 transition-colors group-hover:border-border/60">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>
            {index < projectsByLocale.en.length - 1 && (
              <div class="mt-6 border-b border-border/30 transition-colors group-hover:border-border/50" />
            )}
          </article>
        );
      })
    }
  </div>

  <div class="pt-6">
    <a
      href={projectsHref}
      class="group inline-flex items-center gap-2 text-sm font-medium text-foreground/70 transition-colors hover:text-foreground"
    >
      <span data-i18n-locale="es">{viewAllLabelByLocale.es}</span>
      <span data-i18n-locale="en">{viewAllLabelByLocale.en}</span>
      <span class="transition-transform group-hover:translate-x-1">→</span>
    </a>
  </div>
</section>
