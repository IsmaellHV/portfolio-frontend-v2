---
import type { Locale, Project } from '@/data/portfolio';

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  projectsByLocale: Record<Locale, Project[]>;
  kickerByLocale: Record<Locale, string>;
  headlineByLocale: Record<Locale, string>;
  viewAllLabelByLocale: Record<Locale, string>;
}

const { projectsByLocale, kickerByLocale, viewAllLabelByLocale } = Astro.props;
const projectsHref = '/projects/';
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projects/*.{jpeg,jpg,png,gif}');

const totalEs = projectsByLocale.es.length;
const totalEn = projectsByLocale.en.length;
const localeKeys: Locale[] = ['es', 'en'];
---

<section id="projects" class="py-20 sm:py-28">
  <div class="container-editorial">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-10">
      <span class="eyebrow">
        <span data-i18n-locale="es">{kickerByLocale.es}</span>
        <span data-i18n-locale="en">{kickerByLocale.en}</span>
      </span>
      <span class="font-mono text-[11px] uppercase tracking-[0.1em] text-muted-foreground">
        <span data-i18n-locale="es">01 / {String(totalEs).padStart(2, '0')}</span>
        <span data-i18n-locale="en">01 / {String(totalEn).padStart(2, '0')}</span>
      </span>
    </div>

    {
      localeKeys.map((locale) => (
        <ol data-i18n-locale={locale} class="project-list">
          {projectsByLocale[locale].map((project) => {
            const hasExternalLink = Boolean(project.link && project.link !== '#');
            const hasGithub = Boolean(project.github);
            const imgLoader = project.image ? images[project.image] : undefined;
            return (
              <li>
                <article class="project-row">
                  <a
                    href={hasExternalLink ? project.link : '#'}
                    target={hasExternalLink ? '_blank' : undefined}
                    rel={hasExternalLink ? 'noopener noreferrer' : undefined}
                    class="project-link"
                  >
                    {imgLoader && (
                      <div class="project-thumb">
                        <Image
                          src={imgLoader()}
                          alt={project.title}
                          class="h-full w-full object-cover"
                        />
                      </div>
                    )}
                    <div class="project-meta">
                      <span class="project-index">{project.id}</span>
                      <span class="project-sep" aria-hidden="true">—</span>
                      <span>{project.year}</span>
                    </div>
                    <h3 class="project-title">{project.title}</h3>
                    <div class="project-tags">
                      {project.tags.map((t, i) => (
                        <span class="project-tag">
                          {t}
                          {i < project.tags.length - 1 && <span class="project-tag-sep">·</span>}
                        </span>
                      ))}
                    </div>
                  </a>
                  <div class="project-actions">
                    {hasGithub && (
                      <a
                        href={project.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${project.title} on GitHub`}
                        title="GitHub"
                        class="project-icon"
                      >
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.72-2.78.62-3.37-1.36-3.37-1.36-.45-1.18-1.11-1.49-1.11-1.49-.91-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.36-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.27 2.75 1.05A9.43 9.43 0 0 1 12 6.84c.85.004 1.71.12 2.51.34 1.91-1.32 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.82 0 .27.18.6.69.49C19.14 20.61 22 16.78 22 12.25 22 6.58 17.52 2 12 2z"/>
                        </svg>
                      </a>
                    )}
                    {hasExternalLink && (
                      <a
                        href={project.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${project.title} (visit)`}
                        title="Visit"
                        class="project-icon project-arrow"
                      >
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M7 17L17 7M9 7h8v8" />
                        </svg>
                      </a>
                    )}
                  </div>
                </article>
              </li>
            );
          })}
        </ol>
      ))
    }

    <div class="pt-10">
      <a href={projectsHref} class="group inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground transition-colors hover:text-foreground">
        <span data-i18n-locale="es">{viewAllLabelByLocale.es}</span>
        <span data-i18n-locale="en">{viewAllLabelByLocale.en}</span>
        <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid hsl(var(--line));
  }

  .project-list li {
    list-style: none;
    border-bottom: 1px solid hsl(var(--line));
  }

  .project-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 14px;
    margin: 0 -14px;
    color: hsl(var(--foreground));
    transition:
      background-color 0.25s ease,
      padding 0.25s ease;
  }

  .project-row:hover {
    background: hsl(var(--bg-soft));
  }

  .project-link {
    flex: 1;
    display: grid;
    grid-template-columns: 64px 110px 1fr auto;
    align-items: center;
    gap: 24px;
    color: inherit;
    text-decoration: none;
  }

  .project-actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .project-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    color: hsl(var(--muted-foreground));
    border: 1px solid transparent;
    border-radius: 6px;
    transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .project-icon:hover {
    color: hsl(var(--brand));
    border-color: hsl(var(--line));
  }

  .project-row:hover .project-arrow {
    transform: translate(2px, -2px);
  }

  .project-thumb {
    width: 64px;
    height: 48px;
    overflow: hidden;
    border-radius: 2px;
    border: 1px solid hsl(var(--line));
    background: hsl(var(--bg-soft));
    transition: border-color 0.25s ease;
  }

  .project-thumb img {
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .project-link:hover .project-thumb {
    border-color: hsl(var(--line-strong));
  }

  .project-link:hover .project-thumb img {
    transform: scale(1.05);
  }

  .project-meta {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .project-sep {
    color: hsl(var(--text-dim));
  }

  .project-title {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 0;
    transition: color 0.25s ease;
  }

  .project-link:hover .project-title {
    color: hsl(var(--brand));
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: hsl(var(--muted-foreground));
  }

  .project-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  .project-tag-sep {
    color: hsl(var(--text-dim));
  }

  @media (max-width: 720px) {
    .project-row {
      gap: 8px;
      padding: 14px 12px;
      margin: 0 -12px;
    }
    .project-link {
      grid-template-columns: 56px 1fr;
      gap: 14px;
    }
    .project-thumb {
      width: 56px;
      height: 42px;
      grid-row: 1 / span 3;
    }
    .project-meta {
      grid-column: 2;
      grid-row: 1;
      align-self: end;
      font-size: 10px;
    }
    .project-title {
      grid-column: 2;
      grid-row: 2;
      font-size: 18px;
    }
    .project-tags {
      grid-column: 2;
      grid-row: 3;
      align-self: start;
      gap: 4px;
    }
  }
</style>
