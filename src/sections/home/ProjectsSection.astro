---
import type { Locale, Project } from '@/data/portfolio';

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  projectsByLocale: Record<Locale, Project[]>;
  kickerByLocale: Record<Locale, string>;
  headlineByLocale: Record<Locale, string>;
  viewAllLabelByLocale: Record<Locale, string>;
}

const { projectsByLocale, kickerByLocale, viewAllLabelByLocale } = Astro.props;
const projectsHref = '/projects/';
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projects/*.{jpeg,jpg,png,gif}');

const totalEs = projectsByLocale.es.length;
const totalEn = projectsByLocale.en.length;
const localeKeys: Locale[] = ['es', 'en'];
---

<section id="projects" class="py-20 sm:py-28">
  <div class="container-editorial">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-10">
      <span class="eyebrow">
        <span data-i18n-locale="es">{kickerByLocale.es}</span>
        <span data-i18n-locale="en">{kickerByLocale.en}</span>
      </span>
      <span class="font-mono text-[11px] uppercase tracking-[0.1em] text-muted-foreground">
        <span data-i18n-locale="es">01 / {String(totalEs).padStart(2, '0')}</span>
        <span data-i18n-locale="en">01 / {String(totalEn).padStart(2, '0')}</span>
      </span>
    </div>

    {
      localeKeys.map((locale) => (
        <ol data-i18n-locale={locale} class="project-list">
          {projectsByLocale[locale].map((project) => {
            const hasExternalLink = Boolean(project.link && project.link !== '#');
            return (
              <li>
                <a
                  href={hasExternalLink ? project.link : '#'}
                  target={hasExternalLink ? '_blank' : undefined}
                  rel={hasExternalLink ? 'noopener noreferrer' : undefined}
                  class="project-row"
                >
                  {project.image && (
                    <div class="project-thumb">
                      <Image
                        src={images[project.image!]()}
                        alt={project.title}
                        class="h-full w-full object-cover"
                      />
                    </div>
                  )}
                  <div class="project-meta">
                    <span class="project-index">{project.id}</span>
                    <span class="project-sep" aria-hidden="true">—</span>
                    <span>{project.year}</span>
                  </div>
                  <h3 class="project-title">{project.title}</h3>
                  <div class="project-tags">
                    {project.tags.map((t, i) => (
                      <span class="project-tag">
                        {t}
                        {i < project.tags.length - 1 && <span class="project-tag-sep">·</span>}
                      </span>
                    ))}
                  </div>
                  <span class="project-arrow" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7 17L17 7M9 7h8v8" />
                    </svg>
                  </span>
                </a>
              </li>
            );
          })}
        </ol>
      ))
    }

    <div class="pt-10">
      <a href={projectsHref} class="group inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground transition-colors hover:text-foreground">
        <span data-i18n-locale="es">{viewAllLabelByLocale.es}</span>
        <span data-i18n-locale="en">{viewAllLabelByLocale.en}</span>
        <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid hsl(var(--line));
  }

  .project-list li {
    list-style: none;
    border-bottom: 1px solid hsl(var(--line));
  }

  .project-row {
    display: grid;
    grid-template-columns: 64px 110px 1fr auto 24px;
    align-items: center;
    gap: 24px;
    padding: 18px 14px;
    margin: 0 -14px;
    color: hsl(var(--foreground));
    transition:
      background-color 0.25s ease,
      padding 0.25s ease;
  }

  .project-row:hover {
    background: hsl(var(--bg-soft));
  }

  .project-thumb {
    width: 64px;
    height: 48px;
    overflow: hidden;
    border-radius: 2px;
    border: 1px solid hsl(var(--line));
    background: hsl(var(--bg-soft));
    transition: border-color 0.25s ease;
  }

  .project-thumb img {
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .project-row:hover .project-thumb {
    border-color: hsl(var(--line-strong));
  }

  .project-row:hover .project-thumb img {
    transform: scale(1.05);
  }

  .project-meta {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .project-sep {
    color: hsl(var(--text-dim));
  }

  .project-title {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 0;
    transition: color 0.25s ease;
  }

  .project-row:hover .project-title {
    color: hsl(var(--brand));
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: hsl(var(--muted-foreground));
  }

  .project-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  .project-tag-sep {
    color: hsl(var(--text-dim));
  }

  .project-arrow {
    color: hsl(var(--text-dim));
    transition:
      color 0.25s ease,
      transform 0.25s ease;
  }

  .project-row:hover .project-arrow {
    color: hsl(var(--brand));
    transform: translate(2px, -2px);
  }

  @media (max-width: 720px) {
    .project-row {
      grid-template-columns: 56px 1fr 16px;
      gap: 14px;
      padding: 14px 12px;
      margin: 0 -12px;
    }
    .project-thumb {
      width: 56px;
      height: 42px;
    }
    .project-meta {
      grid-column: 2;
      grid-row: 1;
      align-self: end;
      font-size: 10px;
    }
    .project-title {
      grid-column: 2;
      grid-row: 2;
      font-size: 18px;
    }
    .project-tags {
      grid-column: 2;
      grid-row: 3;
      align-self: start;
      gap: 4px;
    }
    .project-arrow {
      grid-column: 3;
      grid-row: 1 / span 3;
      align-self: center;
    }
  }
</style>
