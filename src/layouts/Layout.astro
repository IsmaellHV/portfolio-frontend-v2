---
import '../styles/global.css';
import { AppRoutes } from '../context/shared/Domain/Routes';
import '@fontsource/oxygen-mono';
import '@fontsource/oxygen';

interface Props {
	title: string;
    description?: string;
}

import { ThemeToggle } from '../components/ui/ThemeToggle';
import { LanguageToggle } from '../components/ui/LanguageToggle';
import { CvButton } from '../components/ui/CvButton';
import { ENVIRONMENT } from '../env';

const {
    title = ENVIRONMENT.APP.TITLE,
    description = ENVIRONMENT.APP.DESCRIPTION
} = Astro.props;

const navItems = [
    { label: "About", href: AppRoutes.home.about },
    { label: "Experience", href: AppRoutes.home.experience },
    { label: "Projects", href: AppRoutes.home.projects },
];
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
        <meta name="keywords" content={ENVIRONMENT.APP.KEYWORDS} />
        <meta name="author" content={ENVIRONMENT.APP.AUTHOR} />
		<link rel="icon" type="image/svg+xml" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ENVIRONMENT.META.OG_IMAGE} />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={ENVIRONMENT.META.OG_IMAGE} />

        <link rel="sitemap" href="/sitemap-index.xml" />

        <script is:inline>
            // Theme Script to prevent flash of wrong theme
            const getThemePreference = () => {
                if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
                    return localStorage.getItem('theme');
                }
                // Default to dark mode regardless of system preference for new visitors
                return 'dark';
            };
            const isDark = getThemePreference() === 'dark';
            document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
        
            if (typeof localStorage !== 'undefined') {
                const observer = new MutationObserver(() => {
                    const isDark = document.documentElement.classList.contains('dark');
                    localStorage.setItem('theme', isDark ? 'dark' : 'light');
                });
                observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
            }
        </script>
	</head>
	<body class="bg-background text-foreground min-h-screen flex flex-col font-sans dots-pattern">
        <header class="fixed top-0 w-full z-50 bg-background/80 backdrop-blur-md border-b border-white/5">
            <div class="container mx-auto px-6 h-16 flex items-center justify-between">
                <a href={AppRoutes.home.root} class="text-xl font-bold tracking-tight hover:text-primary transition-colors">
                    IHV
                </a>
                <div class="flex items-center gap-6">
                    <nav class="hidden md:flex gap-8">
                        {navItems.map(item => (
                            <a href={item.href} class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">
                                {item.label}
                            </a>
                        ))}
                    </nav>
                    <div class="flex items-center gap-2 pl-4 border-l border-border/50">
                         <CvButton client:load />
                         <a href="mailto:contact@ismael.dev" class="hidden md:block text-sm font-medium text-primary hover:text-primary/80 transition-colors mr-4">
                            Contact
                        </a>
                        <LanguageToggle client:load />
                        <ThemeToggle client:load />
                    </div>
                </div>
            </div>
        </header>

		<main class="flex-1 pt-16">
			<slot />
		</main>

        <footer class="border-t border-white/5 py-8 mt-20">
             <div class="container mx-auto px-6 text-center text-sm text-muted-foreground">
                <p>&copy; {new Date().getFullYear()} Ismael Hurtado Vargas.</p>
            </div>
        </footer>
	</body>
</html>
