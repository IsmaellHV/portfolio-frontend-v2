---
import Layout from '@/layouts/Layout.astro';
import HomeSections from '@/sections/home/HomeSections.astro';
import { getPortfolioData, MESSAGES_BY_LOCALE } from '@/data/portfolio';

const dataByLocale = {
  es: getPortfolioData('es'),
  en: getPortfolioData('en'),
};

const titleByLocale = {
  es: `${dataByLocale.es.profile.name} - ${dataByLocale.es.profile.role}`,
  en: `${dataByLocale.en.profile.name} - ${dataByLocale.en.profile.role}`,
};

const descriptionByLocale = {
  es: dataByLocale.es.profile.summary,
  en: dataByLocale.en.profile.summary,
};
---

<Layout titleByLocale={titleByLocale} descriptionByLocale={descriptionByLocale} defaultLocale="es">
  <HomeSections dataByLocale={dataByLocale} messagesByLocale={MESSAGES_BY_LOCALE} />
</Layout>
