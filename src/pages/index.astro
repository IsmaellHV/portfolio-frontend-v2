---
import Layout from '../layouts/Layout.astro';
import { ManagerEntity } from '../context/Portfolio/Home/index';
import { RepositoryImpl } from '../context/Portfolio/Home/Infrastructure/RepositoryImpl';
import { UseCaseGetPortfolio } from '../context/Portfolio/Home/Application/UseCaseGetPortfolio';

const repository = new RepositoryImpl();
const useCase = new UseCaseGetPortfolio(repository);
const data = await useCase.execute();
---

<Layout title={`${data.profile.name} - ${data.profile.role}`} description={data.profile.summary}>
    <ManagerEntity client:load initialData={data} />
</Layout>
