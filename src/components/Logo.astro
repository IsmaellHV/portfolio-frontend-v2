---
interface Props {
  size?: number;
  showAccent?: boolean;
}
const { size = 28, showAccent = true } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 64 64" fill="none" aria-hidden="true">
  {/* I (thick serifs) */}
  <rect x="9" y="14" width="20" height="5" fill="currentColor"></rect>
  <rect x="15" y="14" width="8" height="36" fill="currentColor"></rect>
  <rect x="9" y="45" width="20" height="5" fill="currentColor"></rect>
  {/* H */}
  <rect x="34" y="14" width="8" height="36" fill="currentColor"></rect>
  <rect x="51" y="14" width="8" height="36" fill="currentColor"></rect>
  {showAccent ? (
    <rect x="34" y="28" width="25" height="8" fill="hsl(var(--brand))"></rect>
  ) : (
    <rect x="34" y="28" width="25" height="8" fill="currentColor"></rect>
  )}
</svg>
