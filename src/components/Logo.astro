---
interface Props {
  size?: number;
  showAccent?: boolean;
}
const { size = 28, showAccent = true } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 64 64" fill="none" aria-hidden="true">
  {/* I (with serifs) */}
  <rect x="14" y="18" width="6" height="28" fill="currentColor"></rect>
  <rect x="10" y="18" width="14" height="3" fill="currentColor"></rect>
  <rect x="10" y="43" width="14" height="3" fill="currentColor"></rect>
  {/* H */}
  <rect x="32" y="18" width="6" height="28" fill="currentColor"></rect>
  <rect x="48" y="18" width="6" height="28" fill="currentColor"></rect>
  {showAccent ? (
    <rect x="32" y="30" width="22" height="4" fill="hsl(var(--brand))"></rect>
  ) : (
    <rect x="32" y="30" width="22" height="4" fill="currentColor"></rect>
  )}
</svg>
